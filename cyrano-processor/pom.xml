<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.cyrano</groupId>
        <artifactId>cyrano-parent</artifactId>
        <version>0.4.0-SNAPSHOT</version>
    </parent>

    <artifactId>cyrano-processor</artifactId>
    <name>Cyrano :: APT Processor</name>
    <description>Annotation processor generating $$CyranoClient sources at compile time for @RegisterRestClient interfaces (APT-first rule, codegen audit CG-01). Requires only cyrano-api + java.compiler.</description>

    <dependencies>
        <dependency>
            <groupId>io.vidocq.cyrano</groupId>
            <artifactId>cyrano-api</artifactId>
        </dependency>
        <!-- jakarta.ws.rs-api is transitive via cyrano-api, declared explicitly because the
             processor references @Path/@HttpMethod/param annotations at compile time. -->
        <dependency>
            <groupId>jakarta.ws.rs</groupId>
            <artifactId>jakarta.ws.rs-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- End-to-end test only: drive RestClientBuilder over a compiled fixture and
             assert the generated tier is used (counters in ClientProxyRegistry). -->
        <dependency>
            <groupId>io.vidocq.cyrano</groupId>
            <artifactId>cyrano-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.vidocq.champollion</groupId>
            <artifactId>champollion-jsonb</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.vidocq.champollion</groupId>
            <artifactId>champollion-jsonp</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- Disable annotation processing during the processor's own compilation
                         to avoid circular bootstrap issues. -->
                    <proc>none</proc>
                </configuration>
                <executions>
                    <!-- The end-to-end test serves its requests with the JDK HTTP server
                         (jdk.httpserver), a module the processor does not read. -->
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <compilerArgs combine.children="append">
                                <arg>--add-modules</arg>
                                <arg>jdk.httpserver</arg>
                                <arg>--add-reads</arg>
                                <arg>io.vidocq.cyrano.processor=jdk.httpserver</arg>
                            </compilerArgs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Tests stay on the class path: the end-to-end test builds a client through
                 RestClientBuilder.newBuilder(), whose ServiceLoader lookup fails on the module path
                 because io.vidocq.cyrano.mp.rest.client.api does not declare
                 `uses RestClientBuilderResolver` (see BUG.md). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
