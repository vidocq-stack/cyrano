<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.cyrano</groupId>
        <artifactId>cyrano-parent</artifactId>
        <version>0.4.0-SNAPSHOT</version>
    </parent>

    <artifactId>cyrano-processor</artifactId>
    <name>Cyrano :: APT Processor</name>
    <description>Annotation processor generating $$CyranoClient sources at compile time for @RegisterRestClient interfaces (APT-first rule, codegen audit CG-01). Requires only cyrano-api + java.compiler.</description>

    <dependencies>
        <dependency>
            <groupId>io.vidocq.cyrano</groupId>
            <artifactId>cyrano-api</artifactId>
        </dependency>
        <!-- jakarta.ws.rs-api is transitive via cyrano-api, declared explicitly because the
             processor references @Path/@HttpMethod/param annotations at compile time. -->
        <dependency>
            <groupId>jakarta.ws.rs</groupId>
            <artifactId>jakarta.ws.rs-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- End-to-end test only: drive RestClientBuilder over a compiled fixture and
             assert the generated tier is used (counters in ClientProxyRegistry). -->
        <dependency>
            <groupId>io.vidocq.cyrano</groupId>
            <artifactId>cyrano-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.vidocq.champollion</groupId>
            <artifactId>champollion-jsonb</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.vidocq.champollion</groupId>
            <artifactId>champollion-jsonp</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- Disable annotation processing during the processor's own compilation
                         to avoid circular bootstrap issues. -->
                    <proc>none</proc>
                </configuration>
                <executions>
                    <!-- The end-to-end test serves its requests with the JDK HTTP server
                         (jdk.httpserver), a module the processor does not read. -->
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <compilerArgs combine.children="append">
                                <arg>--add-modules</arg>
                                <arg>jdk.httpserver</arg>
                                <arg>--add-reads</arg>
                                <arg>io.vidocq.cyrano.processor=jdk.httpserver</arg>
                            </compilerArgs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Tests run on the module path, patched into io.vidocq.cyrano.processor (test dependencies
                 such as cyrano-core are not read by the module, hence the reads below):
                 - the end-to-end test serves its requests with the JDK HTTP server and checks which tier
                   of the proxy registry, internal to cyrano-core, served the client;
                 - its fallback case has cyrano-core define a proxy for an interface of this module at
                   run time. The opens is what a host module declares for that fallback; the reads and
                   the export of io.vidocq.cyrano.internal stand in for what the fallback does not do
                   by itself on the module path (BUG-20261008-02). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>
                        --add-modules jdk.httpserver
                        --add-reads io.vidocq.cyrano.processor=jdk.httpserver,io.vidocq.cyrano.core
                        --add-exports io.vidocq.cyrano.core/io.vidocq.cyrano.internal.gen=io.vidocq.cyrano.processor
                        --add-opens io.vidocq.cyrano.processor/io.vidocq.cyrano.processor=io.vidocq.cyrano.core
                        --add-reads io.vidocq.cyrano.core=io.vidocq.cyrano.processor
                        --add-exports io.vidocq.cyrano.core/io.vidocq.cyrano.internal=io.vidocq.cyrano.processor
                    </argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
