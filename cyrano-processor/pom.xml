<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.cyrano</groupId>
        <artifactId>cyrano-parent</artifactId>
        <version>0.4.0-SNAPSHOT</version>
    </parent>

    <artifactId>cyrano-processor</artifactId>
    <name>Cyrano :: APT Processor</name>
    <description>Annotation processor generating $$CyranoClient sources at compile time for @RegisterRestClient interfaces (APT-first rule, codegen audit CG-01). Requires only cyrano-api + java.compiler.</description>

    <dependencies>
        <dependency>
            <groupId>io.vidocq.cyrano</groupId>
            <artifactId>cyrano-api</artifactId>
        </dependency>
        <!-- jakarta.ws.rs-api is transitive via cyrano-api, declared explicitly because the
             processor references @Path/@HttpMethod/param annotations at compile time. -->
        <dependency>
            <groupId>jakarta.ws.rs</groupId>
            <artifactId>jakarta.ws.rs-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- End-to-end test only: drive RestClientBuilder over a compiled fixture and
             assert the generated tier is used (counters in ClientProxyRegistry). -->
        <dependency>
            <groupId>io.vidocq.cyrano</groupId>
            <artifactId>cyrano-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.vidocq.champollion</groupId>
            <artifactId>champollion-jsonb</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.vidocq.champollion</groupId>
            <artifactId>champollion-jsonp</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Same Java Modules workaround as cyrano-core: module-info.java lives in
                 src/main/module-info so testCompile runs on the classpath (the e2e test
                 reads jdk.httpserver and drives cyrano-core test-scope), and the
                 module descriptor is compiled alone at prepare-package. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <executions>
                    <execution>
                        <id>remove-module-info-before-testcompile</id>
                        <phase>generate-test-sources</phase>
                        <goals><goal>clean</goal></goals>
                        <configuration>
                            <excludeDefaultDirectories>true</excludeDefaultDirectories>
                            <filesets>
                                <fileset>
                                    <directory>${project.build.outputDirectory}</directory>
                                    <includes>
                                        <include>module-info.class</include>
                                    </includes>
                                </fileset>
                            </filesets>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- Disable annotation processing during the processor's own compilation
                         to avoid circular bootstrap issues. -->
                    <proc>none</proc>
                </configuration>
                <executions>
                    <execution>
                        <id>compile-module-info</id>
                        <phase>prepare-package</phase>
                        <goals><goal>compile</goal></goals>
                        <configuration>
                            <compileSourceRoots>
                                <compileSourceRoot>${project.basedir}/src/main/module-info</compileSourceRoot>
                            </compileSourceRoots>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
