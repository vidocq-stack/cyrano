<?xml version="1.0" encoding="UTF-8"?>
<!--
    In-reactor TCK runner, gated by the `tck` Maven profile of cyrano-parent
    (TCK harmonisation — workspace-wide effort, mirroring the
    vidocq-runtime-tck-* pattern): a plain `mvn install` neither downloads nor
    runs anything TCK-related.

    History: this module used to be a STANDALONE out-of-reactor POM to work
    around ShrinkWrap Maven Resolver 3.3 (could not parse Model 4.1.0 POMs).
    That constraint disappeared with the Maven 3.9.16 / Model 4.0.0 migration,
    and the MP Rest Client TCK harness builds its Arquillian deployments
    without the ShrinkWrap Maven resolver, so it is safe in-reactor.

    Execution goes through the script (thin wrapper over the reactor):
        ./run-official-tck-mp-rest-client-4.0.sh                      (smoke test)
        ./run-official-tck-mp-rest-client-4.0.sh all                  (full suite)
        ./run-official-tck-mp-rest-client-4.0.sh -Dtest=SomeTest      (targeted class)

    Or directly:
        ./mvnw -Ptck -pl cyrano-tck test                              (smoke)
        ./mvnw -Ptck,tck-official -pl cyrano-tck test                 (full suite)

    MicroProfile Rest Client 4.0 TCK:
        org.eclipse.microprofile.rest.client:microprofile-rest-client-tck:4.0
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.cyrano</groupId>
        <artifactId>cyrano-parent</artifactId>
        <version>0.4.0-SNAPSHOT</version>
    </parent>

    <artifactId>cyrano-tck</artifactId>
    <packaging>jar</packaging>

    <name>Cyrano :: TCK Runner</name>
    <description>Harness de conformance MicroProfile Rest Client 4.0 — point d'entrée pour le TCK officiel</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>
        <cyrano.version>0.4.0-SNAPSHOT</cyrano.version>
        <microprofile.rest.client.version>4.0</microprofile.rest.client.version>
        <cassini.version>0.4.0-SNAPSHOT</cassini.version>
        <chappe.version>0.4.0-SNAPSHOT</chappe.version>
    </properties>

    <repositories>
        <repository>
            <id>vidocq-snapshots</id>
            <url>https://repo.vidocq.dev/snapshots</url>
            <releases><enabled>false</enabled></releases>
            <snapshots><enabled>true</enabled></snapshots>
        </repository>
    </repositories>

    <dependencyManagement>
        <dependencies>
            <!--
                Aligner arquillian-container-spi/impl-base/core-impl-base sur 1.10.1
                pour éviter MalformedParameterizedTypeException sous JDK 25 (même
                contournement que knock-tck / cassini-tck).
            -->
            <dependency>
                <groupId>org.jboss.arquillian.container</groupId>
                <artifactId>arquillian-container-spi</artifactId>
                <version>1.10.1.Final</version>
            </dependency>
            <dependency>
                <groupId>org.jboss.arquillian.container</groupId>
                <artifactId>arquillian-container-impl-base</artifactId>
                <version>1.10.1.Final</version>
            </dependency>
            <dependency>
                <groupId>org.jboss.arquillian.core</groupId>
                <artifactId>arquillian-core-impl-base</artifactId>
                <version>1.10.1.Final</version>
            </dependency>
            <!-- Force CDI API 4.1.0 finale -->
            <dependency>
                <groupId>jakarta.enterprise</groupId>
                <artifactId>jakarta.enterprise.cdi-api</artifactId>
                <version>4.1.0</version>
            </dependency>
            <dependency>
                <groupId>jakarta.enterprise</groupId>
                <artifactId>jakarta.enterprise.lang-model</artifactId>
                <version>4.1.0</version>
            </dependency>
            <dependency>
                <groupId>org.jboss.weld</groupId>
                <artifactId>weld-lite-extension-translator</artifactId>
                <version>6.0.1.Final</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>io.vidocq.cyrano</groupId>
            <artifactId>cyrano-api</artifactId>
            <version>${cyrano.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.cyrano</groupId>
            <artifactId>cyrano-core</artifactId>
            <version>${cyrano.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.cyrano</groupId>
            <artifactId>cyrano-cdi-vauban</artifactId>
            <version>${cyrano.version}</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.microprofile.rest.client</groupId>
            <artifactId>microprofile-rest-client-api</artifactId>
            <version>${microprofile.rest.client.version}</version>
        </dependency>
        <dependency>
            <groupId>jakarta.ws.rs</groupId>
            <artifactId>jakarta.ws.rs-api</artifactId>
            <version>4.0.0</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>6.0.3</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Test harness, never published (same rule as dirac-tck). -->
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <version>${central.publishing.plugin.version}</version>
                <configuration>
                    <skipPublishing>true</skipPublishing>
                </configuration>
            </plugin>
        </plugins>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <release>25</release>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.5</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.3.1</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <!--
            Profil par défaut : smoke test JUnit — vérifie le bootstrap minimal
            (chargement des modules cyrano-core et cyrano-cdi-vauban) sans Arquillian.
        -->
        <profile>
            <id>smoke</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <!--
                En mode smoke, seules les classes hors `arquillian/` sont compilées
                et exécutées : les sources Arquillian/ShrinkWrap dépendent de jars
                (arquillian-container-spi, shrinkwrap-api, cassini-tck, weld…) qui
                ne sont tirés que dans le profil `tck-official`.
            -->
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <configuration>
                            <testExcludes>
                                <exclude>io/vidocq/cyrano/tck/arquillian/**</exclude>
                            </testExcludes>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <excludes>
                                <exclude>io/vidocq/cyrano/tck/arquillian/**</exclude>
                            </excludes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
            Profil TCK officiel : Arquillian TestNG + container Cyrano custom
            (CyranoDeployableContainer démarrant Cassini+Chappe embedded — voir ROADMAP.md M4).
            Cible : 100 % PASS (contrat M4).
        -->
        <profile>
            <id>tck-official</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <useModulePath>false</useModulePath>
                            <dependenciesToScan>
                                <dependency>org.eclipse.microprofile.rest.client:microprofile-rest-client-tck</dependency>
                            </dependenciesToScan>
                            <includes>
                                <include>**/*Test.class</include>
                                <include>**/*Tests.class</include>
                                <include>**/*IT.class</include>
                            </includes>
                            <excludes>
                                <exclude>**/CyranoTckSmokeTest.class</exclude>
                            </excludes>
                            <trimStackTrace>false</trimStackTrace>
                            <redirectTestOutputToFile>false</redirectTestOutputToFile>
                            <useFile>false</useFile>
                            <!--
                                Timeout par test (sec) : protège contre les SSL/timeout
                                tests qui peuvent attendre indéfiniment si Cyrano ne
                                propage pas correctement les délais d'expiration.
                            -->
                            <forkedProcessExitTimeoutInSeconds>30</forkedProcessExitTimeoutInSeconds>
                            <systemPropertyVariables>
                                <arquillian.launch>cyrano</arquillian.launch>
                                <!-- Forcer IPv4 pour éviter les fallback ::1 → 127.0.0.1
                                     mal gérés par Apache HttpClient5 sur macOS. -->
                                <wiremock.server.host>127.0.0.1</wiremock.server.host>
                                <java.net.preferIPv4Stack>true</java.net.preferIPv4Stack>
                            </systemPropertyVariables>
                        </configuration>
                        <dependencies>
                            <dependency>
                                <groupId>org.apache.maven.surefire</groupId>
                                <artifactId>surefire-testng</artifactId>
                                <version>3.5.5</version>
                            </dependency>
                        </dependencies>
                    </plugin>
                </plugins>
            </build>
            <dependencies>
                <!-- TCK MicroProfile Rest Client 4.0 (publié sur Maven Central) -->
                <dependency>
                    <groupId>org.eclipse.microprofile.rest.client</groupId>
                    <artifactId>microprofile-rest-client-tck</artifactId>
                    <version>${microprofile.rest.client.version}</version>
                    <scope>test</scope>
                </dependency>

                <dependency>
                    <groupId>org.jboss.arquillian.testng</groupId>
                    <artifactId>arquillian-testng-container</artifactId>
                    <version>1.10.1.Final</version>
                    <scope>test</scope>
                </dependency>
                <!--
                    Container Arquillian custom (CyranoDeployableContainer) : démarre
                    Cassini+Chappe embedded comme backend HTTP du TCK, puis configure
                    le RestClientBuilder de Cyrano pour pointer dessus.
                    Détails : ROADMAP.md M4.
                -->
                <dependency>
                    <groupId>io.vidocq.cassini</groupId>
                    <artifactId>cassini-core</artifactId>
                    <version>${cassini.version}</version>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>io.vidocq.cassini</groupId>
                    <artifactId>cassini-chappe</artifactId>
                    <version>${cassini.version}</version>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>io.vidocq.chappe</groupId>
                    <artifactId>chappe-api</artifactId>
                    <version>${chappe.version}</version>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>io.vidocq.chappe</groupId>
                    <artifactId>chappe-core</artifactId>
                    <version>${chappe.version}</version>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>io.vidocq.chappe</groupId>
                    <artifactId>chappe-http</artifactId>
                    <version>${chappe.version}</version>
                    <scope>test</scope>
                </dependency>
                <!-- champollion : impl Jakarta JSON-B utilisée par cyrano-core à l'exécution -->
                <dependency>
                    <groupId>io.vidocq.champollion</groupId>
                    <artifactId>champollion-jsonp</artifactId>
                    <version>0.4.0-SNAPSHOT</version>
                    <scope>test</scope>
                </dependency>
                <!--
                    Vauban CDI container: VaubanTckBootstrap starts one CDI Lite container per
                    Arquillian deployment (cditests.* tests).
                -->
                <dependency>
                    <groupId>io.vidocq.vauban</groupId>
                    <artifactId>vauban-core</artifactId>
                    <version>${cyrano.version}</version>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>org.testng</groupId>
                    <artifactId>testng</artifactId>
                    <version>7.10.2</version>
                    <scope>test</scope>
                </dependency>
                <!--
                    Backend HTTP du TCK : le TCK MicroProfile Rest Client 4.0 délègue
                    la simulation de serveur à WireMock (cf. WiremockArquillianTest).
                    Le CyranoDeployableContainer démarre une instance WireMock unique
                    pour toute la suite, écoutant sur 'wiremock.server.port'.
                -->
                <dependency>
                    <groupId>org.wiremock</groupId>
                    <artifactId>wiremock</artifactId>
                    <version>3.10.0</version>
                    <scope>test</scope>
                </dependency>
                <!--
                    Fixtures of the ssl/** and sse/** TCK suites (test-JVM side,
                    never runtime wiring). The TCK's HttpsServer/HttpSseServer
                    are Jetty 11 servers and SslContextTest uses httpcore5's
                    SSLContextBuilder — both already provided transitively by
                    wiremock (jetty-bom 11.0.24 + httpclient5); do NOT redeclare
                    them here with explicit versions, a mismatched httpcore5
                    downgrade broke WireMock's admin client. Only the
                    EventSourceServlet host (jetty-servlets, absent from
                    wiremock's transitive set) and the official Reactive Streams
                    PublisherVerification are added.
                -->
                <dependency>
                    <groupId>org.eclipse.jetty</groupId>
                    <artifactId>jetty-servlets</artifactId>
                    <version>11.0.24</version>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>org.reactivestreams</groupId>
                    <artifactId>reactive-streams-tck</artifactId>
                    <version>1.0.3</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>

