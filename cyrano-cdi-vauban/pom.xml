<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.cyrano</groupId>
        <artifactId>cyrano-parent</artifactId>
        <version>0.4.0-SNAPSHOT</version>
    </parent>

    <artifactId>cyrano-cdi-vauban</artifactId>
    <name>Cyrano :: CDI Vauban Integration</name>
    <description>Intégration CDI 4.1 (Vauban) — découverte auto des interfaces @RegisterRestClient via BCE, injection @Inject @RestClient</description>

    <dependencies>
        <dependency>
            <groupId>io.vidocq.cyrano</groupId>
            <artifactId>cyrano-core</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.inject</groupId>
            <artifactId>jakarta.inject-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- Compile-only: supplies the VaubanComponentProvider service type referenced by the
             APT-generated _VaubanComponents. Provided scope: no runtime dependency on Vauban. -->
        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-api</artifactId>
            <version>0.3.0-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Container CDI pour les tests d'intégration -->
        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-classloader-spi</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.vidocq.champollion</groupId>
            <artifactId>champollion-jsonp</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!--
                        Vauban codegen now runs as an ANNOTATION PROCESSOR on this module's own
                        beans (the Maven plugin is reserved for freezing external, non-APT-processed
                        dependency jars). During the main compile it generates _ClientProxy/_Factory,
                        META-INF/vauban-beans.list (runtime discovery, both class path and module path)
                        and an in-module _VaubanComponents per package (instantiation / producer
                        invocation, no `opens … to io.vidocq.vauban.core`). Build-time only: adds no
                        compile/runtime dependency on Vauban, and the output stays inert under Weld.
                    -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>io.vidocq.vauban</groupId>
                            <artifactId>vauban-processor</artifactId>
                            <version>0.3.0-SNAPSHOT</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
                <executions>
                    <!-- Test fixtures are not application beans (the integration test bootstraps a
                         container on the class path and resolves its often-nested test beans
                         reflectively). Running the APT over them would emit a provider for nested
                         fixtures (bogus package / cannot find symbol). -->
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <proc>none</proc>
                            <!-- The tests serve requests with the JDK HTTP server (jdk.httpserver) and
                                 inspect the proxy registry, internal to cyrano-core. -->
                            <compilerArgs combine.children="append">
                                <arg>--add-modules</arg>
                                <arg>jdk.httpserver</arg>
                                <arg>--add-reads</arg>
                                <arg>io.vidocq.cyrano.cdi.vauban=jdk.httpserver</arg>
                                <arg>--add-exports</arg>
                                <arg>io.vidocq.cyrano.core/io.vidocq.cyrano.internal.gen=io.vidocq.cyrano.cdi.vauban</arg>
                            </compilerArgs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Tests stay on the class path: they build clients through RestClientBuilder.newBuilder()
                 (whose lookup fails on the module path, see cyrano-processor) and
                 CyranoRestClientCdiExtensionDiscoveryTest calls ServiceLoader for a service this module
                 provides but does not use. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>

