<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.cyrano</groupId>
        <artifactId>cyrano-parent</artifactId>
        <version>0.3.0-SNAPSHOT</version>
    </parent>

    <artifactId>cyrano-core</artifactId>
    <name>Cyrano :: Core</name>
    <description>Implémentation MicroProfile Rest Client 4.0 standalone — scanning d'interface, proxy Class-File API, transport JDK HttpClient, mapping JSON-B</description>

    <dependencies>
        <dependency>
            <groupId>io.vidocq.cyrano</groupId>
            <artifactId>cyrano-api</artifactId>
        </dependency>
        <!-- JSON-B (sérialisation corps requête/réponse — implémentation runtime : champollion) -->
        <dependency>
            <groupId>jakarta.json.bind</groupId>
            <artifactId>jakarta.json.bind-api</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.json</groupId>
            <artifactId>jakarta.json-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Implémentation JSON-B (Jakarta JSON Binding) pour les tests d'intégration -->
        <dependency>
            <groupId>io.vidocq.champollion</groupId>
            <artifactId>champollion-jsonb</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Implémentation JSON-P (Jakarta JSON Processing) — transitive de champollion-jsonb -->
        <dependency>
            <groupId>io.vidocq.champollion</groupId>
            <artifactId>champollion-jsonp</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                JPMS workaround cyrano-core.

                Problème : Maven Compiler Plugin 4.0.0-beta-4 détecte le mode JPMS dès que
                module-info.class est présent dans target/classes. En mode JPMS pour
                testCompile, il reconstruit un module-path incompatible avec les dépendances
                test-scope (tests exécutés sur classpath).

                Solution en trois temps :

                1. module-info.java hors de src/main/java (dans src/main/module-info) :
                   default-compile ne le voit pas → pas de module-info.class dans
                   target/classes → Maven ne détecte pas JPMS pour testCompile.

                2. maven-clean-plugin (generate-test-sources) supprime l'éventuel
                   module-info.class stale de target/classes avant testCompile.

                3. maven-compiler-plugin (prepare-package) recompile module-info.java seul
                   dans target/classes avant l'assemblage du JAR.

                Conséquence : les tests de cyrano-core s'exécutent sur le classpath
                (useModulePath=false). Le câblage JPMS sera validé par le smoke TCK.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <executions>
                    <execution>
                        <id>remove-module-info-before-testcompile</id>
                        <phase>generate-test-sources</phase>
                        <goals><goal>clean</goal></goals>
                        <configuration>
                            <excludeDefaultDirectories>true</excludeDefaultDirectories>
                            <filesets>
                                <fileset>
                                    <directory>${project.build.outputDirectory}</directory>
                                    <includes>
                                        <include>module-info.class</include>
                                    </includes>
                                </fileset>
                            </filesets>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>compile-module-info</id>
                        <phase>prepare-package</phase>
                        <goals><goal>compile</goal></goals>
                        <configuration>
                            <compileSourceRoots>
                                <compileSourceRoot>${project.basedir}/src/main/module-info</compileSourceRoot>
                            </compileSourceRoots>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>

