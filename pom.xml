    <scm>
        <url>https://codeberg.org/Vidocq/cyrano</url>
        <connection>scm:git:https://codeberg.org/Vidocq/cyrano.git</connection>
        <developerConnection>scm:git:git@forge.vidocq.dev:vidocq/cyrano.git</developerConnection>
    </scm>

    <properties>
        <!--
            MicroProfile Rest Client 4.0 upstream reste un module automatique.
            Cyrano le repacke dans cyrano-mp-rest-client-api (module explicite)
            pour garder un graphe JPMS linkable par jlink.
        -->
        <microprofile.rest.client.version>4.0</microprofile.rest.client.version>

        <!-- Jakarta REST (annotations JAX-RS utilisées sur les interfaces client) -->
        <jakarta.ws.rs.version>4.0.0</jakarta.ws.rs.version>

        <!-- Jakarta JSON-B (sérialisation corps requête/réponse — implémentation : champollion) -->
        <jakarta.json.bind.version>3.0.1</jakarta.json.bind.version>
        <!-- Jakarta JSON-P (transitive de JSON-B) -->
        <jakarta.json.version>2.1.3</jakarta.json.version>

        <!-- CDI -->
        <jakarta.cdi.version>4.1.0</jakarta.cdi.version>
        <jakarta.inject.version>2.0.1</jakarta.inject.version>
        <jakarta.annotation.version>3.0.0</jakarta.annotation.version>

        <!-- Reactive Streams (SSE, MP Rest Client 4.0 §10 — interface-only de-facto spec jar) -->
        <reactive.streams.version>1.0.4</reactive.streams.version>
    </properties>

    <!--
        cyrano-tck est volontairement HORS reactor (POM Model 4.0.0 standalone)
        pour contourner ShrinkWrap Maven Resolver 3.3 qui ne sait pas parser
        les POMs Model 4.1.0. Il sera invoqué par run-official-tck-mp-rest-client-4.0.sh
        après installation locale du reactor.
    -->
    <modules>
        <module>cyrano-mp-rest-client-api</module>
        <module>cyrano-api</module>
        <module>cyrano-processor</module>
        <module>cyrano-core</module>
        <module>cyrano-cdi-vauban</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- MicroProfile Rest Client API -->
            <dependency>
                <groupId>org.eclipse.microprofile.rest.client</groupId>
                <artifactId>microprofile-rest-client-api</artifactId>
                <version>${microprofile.rest.client.version}</version>
            </dependency>

            <!-- Jakarta REST (annotations JAX-RS utilisées par les interfaces client) -->
            <dependency>
                <groupId>jakarta.ws.rs</groupId>
                <artifactId>jakarta.ws.rs-api</artifactId>
                <version>${jakarta.ws.rs.version}</version>
            </dependency>

            <!-- Jakarta JSON-B (implémentation runtime : champollion) -->
            <dependency>
                <groupId>jakarta.json.bind</groupId>
                <artifactId>jakarta.json.bind-api</artifactId>
                <version>${jakarta.json.bind.version}</version>
            </dependency>

            <!-- Jakarta JSON-P (transitive de JSON-B, implémentation : champollion) -->
            <dependency>
                <groupId>jakarta.json</groupId>
                <artifactId>jakarta.json-api</artifactId>
                <version>${jakarta.json.version}</version>
            </dependency>

            <!--
                Reactive Streams — required by the MP Rest Client 4.0 SSE API
                surface (spec §10: org.reactivestreams.Publisher return types).
                Zero-dep waiver: interface-only de-facto spec jar (4 interfaces,
                no implementation code), Automatic-Module-Name org.reactivestreams,
                same standing as a Jakarta/MicroProfile spec API.
            -->
            <dependency>
                <groupId>org.reactivestreams</groupId>
                <artifactId>reactive-streams</artifactId>
                <version>${reactive.streams.version}</version>
            </dependency>

            <!-- CDI -->
            <dependency>
                <groupId>jakarta.enterprise</groupId>
                <artifactId>jakarta.enterprise.cdi-api</artifactId>
                <version>${jakarta.cdi.version}</version>
            </dependency>
            <dependency>
                <groupId>jakarta.inject</groupId>
                <artifactId>jakarta.inject-api</artifactId>
                <version>${jakarta.inject.version}</version>
            </dependency>
            <dependency>
                <groupId>jakarta.annotation</groupId>
                <artifactId>jakarta.annotation-api</artifactId>
                <version>${jakarta.annotation.version}</version>
            </dependency>

            <!-- Implémentations runtime (Vidocq) -->
            <dependency>
                <groupId>io.vidocq.champollion</groupId>
                <artifactId>champollion-jsonp</artifactId>
                <version>0.3.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.champollion</groupId>
                <artifactId>champollion-jsonb</artifactId>
                <version>0.3.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.vauban</groupId>
                <artifactId>vauban-core</artifactId>
                <version>0.3.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.vauban</groupId>
                <artifactId>vauban-classloader-spi</artifactId>
                <version>0.3.0-SNAPSHOT</version>
            </dependency>

            <!-- Modules internes Cyrano -->
            <dependency>
                <groupId>io.vidocq.cyrano</groupId>
                <artifactId>cyrano-mp-rest-client-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.cyrano</groupId>
                <artifactId>cyrano-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.cyrano</groupId>
                <artifactId>cyrano-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.cyrano</groupId>
                <artifactId>cyrano-processor</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.cyrano</groupId>
                <artifactId>cyrano-cdi-vauban</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!--
        CYR-001 (2026-06-03) : le workaround JPMS qui vivait ici a été déplacé
        dans cyrano-mp-rest-client-api/pom.xml où il est strictement nécessaire
        (requires static jakarta.cdi/inject/annotation mal routés par
        maven-compiler-plugin 3.13.0 + Maven 3.9.16 au testCompile).
        Les autres modules du reactor n'en ont pas besoin.
    -->
</project>
